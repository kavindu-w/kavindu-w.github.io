---
import VisitorCounter from "./VisitorCounter.jsx";
const builtAt = new Date();
const year = builtAt.getFullYear();
const builtAtLabel = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}).format(builtAt);
---

<footer class="footer">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-4 footer-copywright">
        <h3>Copyright &copy; {year} akw</h3>
      </div>
      <div class="col-md-4 footer-copywright">
        <VisitorCounter client:only="react" />
        <small style="color:rgba(255,255,255,0.9)">
          Last updated <time datetime={builtAt.toISOString()}>{builtAtLabel} UTC</time>
        </small>
      </div>
      <div
        class="col-md-4 footer-copywright"
        style="display:flex;align-items:center;justify-content:center;gap:1rem"
      >
        <h3>Designed by Kavindu Warnakulasuriya</h3>
      </div>
    </div>
  </div>
</footer>
